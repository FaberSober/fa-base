<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.faber.api.base.admin.mapper.SystemUpdateLogMapper">

    <select id="getDetailById" resultType="com.faber.api.base.admin.entity.SystemUpdateLog">
        SELECT id,
               no,
               name,
               ver,
               ver_no,
               remark,
               log,
               crt_time,
               status,
               file_name,
               checksum,
               duration_ms,
               error_msg
        FROM base_system_update_log
        WHERE id = #{id}
        LIMIT 1
    </select>

</mapper>
