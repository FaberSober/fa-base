<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.faber.api.base.calendar.mapper.BaseCalendarDayMapper">

    <select id="selectActiveByCalendarCodeAndDate" resultType="com.faber.api.base.calendar.entity.BaseCalendarDay">
        SELECT *
        FROM base_calendar_day
        WHERE calendar_code = #{calendarCode}
          AND calendar_date = #{calendarDate}
          AND deleted = #{deleted}
        LIMIT 1
    </select>

</mapper>
